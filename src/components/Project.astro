---
interface Props {
  project: {
    index: string;
    meta: string;
    title: string;
    lead: string;
    metrics: { value: string; label: string }[];
    stack: string[];
    links: { label: string; href: string }[];
  };
  window: string;
  hint: string;
  flip?: boolean;
}
const { project: p, window: windowTitle, hint, flip = false } = Astro.props;
const links = p.links.filter((l) => l.href);
---

<article class:list={["project", { flip }]}>
  <div class="info" data-reveal>
    <div class="top">
      <span class="idx">{p.index}</span>
      <span class="label">{p.meta}</span>
    </div>
    <h3>{p.title}</h3>
    <p class="lead">{p.lead}</p>

    <dl class="metrics">
      {
        p.metrics.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="chips">{p.stack.map((s) => <li>{s}</li>)}</ul>

    {
      links.length > 0 && (
        <div class="links">
          {links.map((l) => (
            <a class="btn" href={l.href} target="_blank" rel="noopener">
              {l.label} <span class="arrow">↗</span>
            </a>
          ))}
        </div>
      )
    }
  </div>

  <div class="demo" data-reveal>
    <div class="chrome">
      <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="wtitle">{windowTitle}</span>
      <span class="live"><i></i>interactivo</span>
    </div>
    <div class="body">
      <slot />
    </div>
    <p class="hint">{hint}</p>
  </div>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    padding: clamp(48px, 8vw, 96px) 0;
    border-top: 1px solid var(--line);
  }
  .project.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .project.flip .info {
    order: 2;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .idx {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    border: 1px solid rgba(255, 122, 69, 0.35);
    border-radius: 999px;
    padding: 3px 9px;
  }
  h3 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(44px, 5.4vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.025em;
  }
  .lead {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 17px;
    max-width: 38ch;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 36px 0 0;
    border-top: 1px solid var(--line);
  }
  .metrics div {
    padding: 16px 12px 0 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .metrics dt {
    order: 2;
  }
  .metrics div + div {
    padding-left: 16px;
    border-left: 1px solid var(--line);
  }
  dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(34px, 3.4vw, 44px);
    line-height: 1;
  }
  dt {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    font-family: var(--mono);
    font-size: 11px;
    padding: 5px 9px;
    border-radius: 6px;
    background: var(--bg-3);
    color: #c9c7c1;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  /* Ventana de la demo */
  .demo {
    position: relative;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--bg-2), var(--bg));
    box-shadow:
      0 40px 80px -40px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  .demo::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(600px circle at 80% 0%, rgba(255, 122, 69, 0.08), transparent 50%);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .lights {
    display: flex;
    gap: 6px;
  }
  .lights i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--line-2);
  }
  .wtitle {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 10px;
    color: var(--accent);
  }
  .live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: pulse 1.8s infinite;
  }
  .body {
    position: relative;
  }
  .hint {
    margin: 0;
    padding: 10px 16px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    color: var(--faint);
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }
  @media (max-width: 900px) {
    .project,
    .project.flip {
      grid-template-columns: 1fr;
    }
    .project.flip .info {
      order: 0;
    }
  }
</style>
